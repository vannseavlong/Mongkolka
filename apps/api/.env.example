# Google OAuth credentials (single OAuth client; register ALL redirect URIs below on it)
# Get these at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI for the backend's own Sheets/Drive OAuth (same one used by `lsdb sync`)
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Per-portal Google Sign-In redirect URIs (each must also be registered on the OAuth client above)
ADMIN_GOOGLE_REDIRECT_URI=http://localhost:4000/admin/auth/callback
COUPLE_GOOGLE_REDIRECT_URI=http://localhost:4000/couple/auth/callback
VENDOR_GOOGLE_REDIRECT_URI=http://localhost:4000/vendor/auth/callback

# Where each portal's frontend lives — the API redirects here after login with ?token=<jwt>
ADMIN_FRONTEND_URL=http://localhost:3001
COUPLE_FRONTEND_URL=http://localhost:3002
VENDOR_FRONTEND_URL=http://localhost:3003

# Your central admin Google Sheet ID
# Create a blank Google Sheet and paste the ID from its URL here
ADMIN_SHEET_ID=

# Development actor sheet IDs (one per actor type)
DEV_COUPLE_SHEET_ID=
DEV_VENDOR_SHEET_ID=

# Super admin email (new user sheets will be shared with this account)
SUPER_ADMIN_EMAIL=

# Secret used to sign/verify portal login JWTs — set a long random value
JWT_SECRET=

# Express server port
PORT=4000

# Guest photo storage: "local" (dev/pilot, served from this API) or "s3" (R2/S3-compatible)
PHOTO_STORAGE=local
# PHOTO_LOCAL_DIR=uploads
# PUBLIC_API_URL=http://localhost:4000
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://photos.example.com
