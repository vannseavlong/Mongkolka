{
  "name": "mongkolka",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "deploy:admin": "turbo run build --filter=admin && firebase deploy --only hosting:admin",
    "deploy:couple": "turbo run build --filter=couple && firebase deploy --only hosting:couple"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.10.7",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "gitask-cli": "^0.2.0"
  }
}
